# =============================================================================
# Gecko Agent Landing — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs avant de lancer l'app.
# =============================================================================

# --- Flask Core ---
# Clé secrète pour signer les sessions, CSRF tokens, etc.
# Générer avec : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme-generate-a-real-key-with-secrets-token-hex

# Environnement : development | production
FLASK_ENV=development

# Mode debug Flask (1 = on, 0 = off). NE JAMAIS activer en production.
FLASK_DEBUG=1

# --- Base de données ---
# SQLite local par défaut. Pour la prod, basculer sur PostgreSQL.
DATABASE_URL=sqlite:///instance/database.db

# --- Sécurité ---
# Backend pour Flask-Limiter (memory en dev, redis en prod si besoin de scale)
RATELIMIT_STORAGE_URI=memory://

# --- Analytics ---
# Domaine Plausible (RGPD-friendly, sans cookie). Laisser vide pour désactiver.
# Ex en prod : PLAUSIBLE_DOMAIN=gecko-agent.com (le domaine doit être configuré dans ton compte Plausible)
PLAUSIBLE_DOMAIN=

# --- Flask app (utilisé par `flask db upgrade` en prod) ---
# Pointer vers le package app (Flask trouve create_app() automatiquement)
FLASK_APP=app

# --- Liens externes affichés sur la landing ---
# URL Chrome Web Store de l'extension Gecko Agent
CHROME_WEBSTORE_URL=https://chromewebstore.google.com/detail/gecko-agent/fodegmmmomdfjdfaamcldkemopidniep

# URL du repo GitHub de l'extension
GITHUB_REPO_URL=https://github.com/Gecko51/gecko-agent
